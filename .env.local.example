# Public Supabase configuration (safe to expose in a browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TINY_CLIENT_ID=your-tiny-client-id
TINY_CLIENT_SECRET=your-tiny-client-secret

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
