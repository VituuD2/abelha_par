# Public Supabase configuration (safe to expose in a browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
APP_URL=http://localhost:3000

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TINY_CLIENT_ID=your-tiny-client-id
TINY_CLIENT_SECRET=your-tiny-client-secret
# Optional: Tiny ecommerce ID used to classify WooCommerce orders.
OLIST_WOOCOMMERCE_ECOMMERCE_ID=20161

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=q+d1KW5ZyaakT9oBICt7wMgRj+BsMdh5upBGpC0XRmw=

# Required for the durable Olist incremental sync. Use independent, high-entropy values.
# Set CRON_SECRET in Vercel too; Vercel sends it as a Bearer token to the cron route.
OLIST_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters
